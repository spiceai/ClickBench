#!/bin/bash
set -e

if [ ! -x "$HOME/.spice/bin/spiced" ]; then
    curl https://install.spiceai.org | /bin/bash
fi

# The installer drops binaries into ~/.spice/bin and only suggests adding it
# to PATH. Symlink into /usr/local/bin so sibling scripts (check, load,
# query, start) find them unconditionally.
sudo ln -sf "$HOME/.spice/bin/spiced" /usr/local/bin/spiced
sudo ln -sf "$HOME/.spice/bin/spice" /usr/local/bin/spice

spiced --version
